# API
PORT=3000
DATABASE_URL=postgresql://cmf:cmf@localhost:5432/cmf?schema=public
REDIS_URL=redis://localhost:6379   # leave empty to use an in-memory bus (single instance only)
JWT_SECRET=change-me
# Admin panel/API key (Step 5). Leave empty to disable the admin API.
# Generate one with: openssl rand -hex 24
ADMIN_API_KEY=
DEFAULT_REGION=IN
DEFAULT_TIMEZONE=Asia/Kolkata

# Data provider: "mock" (default) or a real provider added later
CRICKET_PROVIDER=mock
CRICKET_API_KEY=

# Background jobs
JOBS_ENABLED=true        # false = no fixture sync or live polling (e.g. read-only replicas)
SYNC_ON_BOOT=true        # run a fixture sync when the API starts
LIVE_POLL_MS=15000       # live score poll interval

# Push (Step 7)
FCM_SERVICE_ACCOUNT_JSON=
