{
  "name": "cricket-match-finder",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "pnpm -r --filter ./packages/** --filter ./apps/api --filter ./apps/admin run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "dev:api": "pnpm --filter @cmf/api dev",
    "dev:admin": "pnpm --filter @cmf/admin dev",
    "dev:mobile": "pnpm --filter @cmf/mobile start",
    "db:up": "docker compose up -d postgres redis"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "esbuild",
      "@prisma/client",
      "prisma",
      "@prisma/engines"
    ]
  }
}
